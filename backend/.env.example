# Copy this file to .env and fill in real values for your machine.
# The start-vellora script does this automatically the first time you run it.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vellora"

# Port the backend API server listens on.
PORT=4000

# URL of the running frontend, used for CORS.
FRONTEND_URL="http://localhost:5173"

# Secret used to sign auth tokens. The start script generates a random one
# for you automatically; only set this manually if you're doing it by hand.
JWT_SECRET="change-this-to-a-long-random-string"

# Set to "production" when deploying for real.
NODE_ENV="development"

# Cloudinary credentials for image uploads (profile pictures, post covers)
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"
